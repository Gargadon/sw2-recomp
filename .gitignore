# Build output, copied SDK DLLs, caches and runtime data.
/out/
/build/
/userdata/
/cache/
/dist/
/pgo/
*.profraw
*.profdata
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja
.ninja_deps
.ninja_log
compile_commands.json

# Recompiled game code: regenerate from the local game and manifest.
# Keep generated/rexglue.cmake, which CMakeLists.txt includes directly.
/generated/*/
!/generated/rexglue.cmake

# Local IDE and CMake settings.
/.vs/
/.vscode/
CMakeUserPresets.json
*.user
*.suo

# Binaries, symbols and crash dumps outside the build directory.
*.exe
*.dll
*.obj
*.o
*.lib
*.pdb
*.pch
*.ilk
*.map
*.dmp
*.etl

# Runtime logs and diagnostic captures.
logs/
*.log
heap-diagnostics.txt
allocation-diagnostics.txt

# Local game inputs, if copied into the project.
*.iso
*.xex
/Samurai Warriors 2 (USA, Europe)/
/Samurai Warriors 2 Title Update #3/

# Editor temporary files.
*.swp
*.swo
*~
.DS_Store
Thumbs.db
